  "update_workspace_context": {
    "$defs": {
      "ContextItemUpdate": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "default": "remember",
            "enum": [
              "remember",
              "revise",
              "set_status"
            ],
            "title": "Operation",
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "goal",
              "question",
              "assumption",
              "opportunity"
            ],
            "title": "Kind",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 600,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Text"
          },
          "user_excerpt": {
            "default": "",
            "description": "For fact memory, copy an exact excerpt from the CURRENT human message. The host stores this quote, not a generated source-result paraphrase.",
            "maxLength": 600,
            "title": "User Excerpt",
            "type": "string"
          },
          "item_id": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{32}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Item Id"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "active",
                  "answered",
                  "deferred",
                  "paused",
                  "cancelled",
                  "proposed",
                  "selected",
                  "dismissed"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "belief": {
            "default": "inferred",
            "enum": [
              "user_stated",
              "inferred"
            ],
            "title": "Belief",
            "type": "string"
          },
          "concept_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "title": "Concept Ids",
            "type": "array"
          },
          "process_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "title": "Process Ids",
            "type": "array"
          },
          "goal_id": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{32}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Goal Id"
          },
          "why": {
            "default": "",
            "maxLength": 400,
            "title": "Why",
            "type": "string"
          },
          "next_step": {
            "default": "",
            "maxLength": 400,
            "title": "Next Step",
            "type": "string"
          },
          "answer": {
            "default": "",
            "maxLength": 600,
            "title": "Answer",
            "type": "string"
          },
          "priority": {
            "default": "medium",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Priority",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "ContextItemUpdate",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "workspace": {
        "maxLength": 40,
        "minLength": 1,
        "title": "Workspace",
        "type": "string"
      },
      "expected_revision": {
        "minimum": 0,
        "title": "Expected Revision",
        "type": "integer"
      },
      "idempotency_key": {
        "maxLength": 160,
        "minLength": 8,
        "title": "Idempotency Key",
        "type": "string"
      },
      "updates": {
        "items": {
          "$ref": "#/$defs/ContextItemUpdate"
        },
        "maxItems": 6,
        "title": "Updates",
        "type": "array"
      },
      "message": {
        "anyOf": [
          {
            "maxLength": 1500,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Message"
      },
      "expected_model_revision": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Model Revision"
      }
    },
    "required": [
      "workspace",
      "expected_revision",
      "idempotency_key"
    ],
    "title": "ContextUpdate",
    "type": "object"
  }
